{
  "name": "@local/mo-reader",
  "version": "0.1.0",
  "private": true,
  "description": "墨读：在 DSH 中阅读文字、漫画、音频、视频与网站入口。",
  "author": "JUNQINGV587",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUNQINGV587/mo-reader.git"
  },
  "bugs": {
    "url": "https://github.com/JUNQINGV587/mo-reader/issues"
  },
  "homepage": "https://github.com/JUNQINGV587/mo-reader#readme",
  "engines": {
    "node": ">=24.9.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.gl.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser/scroll-restore.runner.mjs && node test/browser/shelf-pagination.runner.mjs && node test/browser/blocks.runner.mjs && node test/browser/screens.runner.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.3",
    "cheerio": "^1.1.2",
    "hls.js": "^1.7.4",
    "iconv-lite": "^0.6.3",
    "jsonpath-plus": "^10.3.0",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-storage-json": "0.2.2-alpha.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}

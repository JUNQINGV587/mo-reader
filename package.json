{
  "name": "@local/mo-reader",
  "version": "0.2.0",
  "private": true,
  "description": "墨读：在 DSH 中复刻「阅读」的阅读插件。",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./dist/server/index.js",
    "./client": "./dist/client/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build --config vite.client.config.ts && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.3",
    "cheerio": "^1.2.0",
    "hls.js": "^1.7.4",
    "iconv-lite": "^0.6.3",
    "jsonpath-plus": "^10.4.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438",
    "vue": "^3.5.45",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "jsdom": "^31.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
